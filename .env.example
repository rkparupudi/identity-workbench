# Copy to .env (or set these in your shell). Everything is optional.

# Enables the model layer (column-mapping suggestions, summaries, explanations).
# Without it the workbench runs fully offline using built-in rules and text.
ANTHROPIC_API_KEY=

# Model used when ANTHROPIC_API_KEY is set.
IDW_MODEL=claude-sonnet-5-5

# Where the local store (SQLite file) lives. Default: ~/.identity-workbench
IDW_HOME=

# The only folder the MCP server may read files from / write sample data to.
# Default: the current working directory when the server starts.
IDW_DATA_DIR=

# Matching thresholds (0-100) and dormancy window in days.
IDW_MATCH_UPPER=90
IDW_MATCH_LOWER=70
IDW_DORMANT_DAYS=90
